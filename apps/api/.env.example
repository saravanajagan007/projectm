PORT=4000
NODE_ENV=development

# Database connection:
# Default SQLite local database for instant zero-dependency setup:
DATABASE_URL="file:./dev.db"

# Or for PostgreSQL in production / docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projectm?schema=public"

# JWT Secrets (replace with strong random strings in production)
JWT_ACCESS_SECRET="projectm-super-secure-access-token-secret-2026-prod-ready"
JWT_REFRESH_SECRET="projectm-super-secure-refresh-token-secret-2026-prod-ready"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# CORS Frontend URLs (comma-separated or single)
FRONTEND_URL="http://localhost:3000"

# Throttler rate-limit (60 requests per minute)
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
